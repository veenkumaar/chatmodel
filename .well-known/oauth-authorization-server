{
  "issuer": "https://chatmodel.in",
  "authorization_endpoint": "https://chatmodel.in/login.php",
  "token_endpoint": "https://chatmodel.in/api/token.php",
  "jwks_uri": "https://chatmodel.in/.well-known/jwks.json",
  "response_types_supported": [
    "code",
    "token"
  ],
  "grant_types_supported": [
    "authorization_code",
    "client_credentials",
    "refresh_token"
  ],
  "token_endpoint_auth_methods_supported": [
    "client_secret_post",
    "client_secret_basic",
    "none"
  ],
  "scopes_supported": [
    "openid",
    "profile",
    "email",
    "chat",
    "tenants:read",
    "tenants:write"
  ],
  "code_challenge_methods_supported": [
    "S256",
    "plain"
  ],
  "service_documentation": "https://chatmodel.in/faq.php",
  "agent_auth": {
    "skill": "https://chatmodel.in/auth.md",
    "register_uri": "https://chatmodel.in/api/agent/register.php",
    "identity_types_supported": [
      "identity_assertion",
      "anonymous"
    ],
    "identity_assertion": {
      "assertion_types_supported": [
        "urn:ietf:params:oauth:token-type:id-jag",
        "verified_email"
      ],
      "credential_types_supported": [
        "bearer_token",
        "api_key"
      ],
      "claim_uri": "https://chatmodel.in/api/agent/claim.php",
      "revocation_uri": "https://chatmodel.in/api/agent/revoke.php"
    },
    "anonymous": {
      "credential_types_supported": [
        "bearer_token"
      ],
      "claim_uri": "https://chatmodel.in/api/agent/claim.php"
    },
    "events_supported": [
      "https://schemas.openid.net/secevent/oauth/event-type/token-revocation"
    ]
  }
}
