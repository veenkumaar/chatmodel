# ==============================================================================
# ChatModel SaaS Platform - Production Server Configuration (.htaccess)
# ==============================================================================

# 1. Protect Sensitive Files & Directories
<FilesMatch "\.(db|sqlite|sqlite3|sql|log|ini|env|sh|md|git|bak|backup)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 2. Disable Directory Browsing
Options -Indexes

# 3. Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Allow iframe embedding for assistant widget on client websites
    Header set Access-Control-Allow-Origin "*"
</IfModule>

# 4. Gzip / Deflate Compression for Speed
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

# 5. Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access 1 month"
    ExpiresByType image/jpeg "access 1 month"
    ExpiresByType image/gif "access 1 month"
    ExpiresByType image/png "access 1 month"
    ExpiresByType image/svg+xml "access 1 month"
    ExpiresByType text/css "access 1 week"
    ExpiresByType application/javascript "access 1 week"
</IfModule>

# 6. URL Rewriting & Routing
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block access to hidden dotfiles (.git, .env)
    RewriteRule ^\.(.*)$ - [F,L]

    # Block direct access to data or db folders
    RewriteRule ^(data|db)(/.*)?$ - [F,L]

    # If file or directory exists, serve directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route all other non-static requests to index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
